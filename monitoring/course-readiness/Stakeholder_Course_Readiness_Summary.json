  "Dev_Display_Rules": [
   [
    "state",
    "meaning",
    "api_v3_empty_reason_code",
    "frontend_display_rule"
   ],
   [
    "ADMITTED (the value)",
    "Read from the official source and admitted (Layer 1, a page read or a Layer 4 decision)",
    "(none; the field has a value)",
    "Show the value"
   ],
   [
    "TRYING",
    "A page is found and a read, re-read, Layer 3 or Layer 4 step is queued or running",
    "pending_extraction",
    "Hide the field, or show \"Being checked\"; never show a guess"
   ],
   [
    "POSSIBLE_NEEDS_SOURCE",
    "No course or provider page found yet, the site only, a blocked site or no reader for the field",
    "source_unavailable",
    "Hide the field; show \"Check with the provider\" with the provider's website link"
   ],
   [
    "NOT_POSSIBLE",
    "Read against the official source and not published there (for example a month-only intake, or not stated on the page)",
    "not_published_by_provider (online_only_no_campus for campus fields)",
    "Show \"Not published by the provider\" (or \"Online only\" for campus fields); do not ask again"
