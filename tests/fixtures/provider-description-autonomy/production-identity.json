  "constraints": [
    {
      "conname": "provider_identity_findings_check_code_check",
      "contype": "c",
      "relation": "pipeline.provider_identity_findings",
      "definition": "CHECK (check_code = ANY (ARRAY['website_malformed'::text, 'identity_unconfirmed'::text, 'domain_shared'::text, 'redirected_or_parked'::text, 'register_changed'::text]))"
    },
    {
      "conname": "provider_identity_findings_pkey",
      "contype": "p",
      "relation": "pipeline.provider_identity_findings",
      "definition": "PRIMARY KEY (provider_id, check_code)"
    },
    {
      "conname": "provider_identity_findings_provider_id_fkey",
      "contype": "f",
      "relation": "pipeline.provider_identity_findings",
      "definition": "FOREIGN KEY (provider_id) REFERENCES catalogue.providers(id)"
    },
    {
      "conname": "provider_identity_findings_state_check",
      "contype": "c",
      "relation": "pipeline.provider_identity_findings",
      "definition": "CHECK (state = ANY (ARRAY['open'::text, 'cleared'::text]))"
    },
    {
      "conname": "provider_lifecycle_events_check",
      "contype": "c",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "CHECK (scope = 'provider'::text AND provider_id IS NOT NULL AND transition <> 'retired'::text OR scope = 'country'::text AND country_id IS NOT NULL AND transition = 'retired'::text)"
    },
    {
      "conname": "provider_lifecycle_events_check1",
      "contype": "c",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "CHECK (transition <> 'merged'::text OR successor_provider_id IS NOT NULL)"
    },
    {
      "conname": "provider_lifecycle_events_pkey",
      "contype": "p",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "conname": "provider_lifecycle_events_provider_id_fkey",
      "contype": "f",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "FOREIGN KEY (provider_id) REFERENCES catalogue.providers(id)"
    },
    {
      "conname": "provider_lifecycle_events_scope_check",
      "contype": "c",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "CHECK (scope = ANY (ARRAY['provider'::text, 'country'::text]))"
    },
    {
      "conname": "provider_lifecycle_events_state_check",
      "contype": "c",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "CHECK (state = ANY (ARRAY['proposed'::text, 'planned'::text, 'approved'::text, 'executed'::text, 'reversed'::text, 'rejected'::text]))"
    },
    {
      "conname": "provider_lifecycle_events_successor_provider_id_fkey",
      "contype": "f",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "FOREIGN KEY (successor_provider_id) REFERENCES catalogue.providers(id)"
    },
    {
      "conname": "provider_lifecycle_events_transition_check",
      "contype": "c",
      "relation": "pipeline.provider_lifecycle_events",
      "definition": "CHECK (transition = ANY (ARRAY['deregistered'::text, 'closed'::text, 'merged'::text, 'temporarily_unavailable'::text, 'retired'::text]))"
    }
  ]
}
