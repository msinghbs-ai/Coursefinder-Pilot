#!/usr/bin/env python3
# Local Docker transport only. No hosted database credentials or target are accepted.
import os,sys,subprocess
args=sys.argv[1:]; data=None
if '-f' in args:
 i=args.index('-f'); data=open(args[i+1],'rb').read(); args[i+1]='-'
cmd=['docker','--host=unix:///var/run/docker.sock','exec','-i','-e','PGUSER=postgres','-e','PGOPTIONS='+os.environ.get('PGOPTIONS',''),'intake-ui-postgres','psql']+args
env={k:v for k,v in os.environ.items() if k not in ['DOCKER_HOST','DOCKER_CONTEXT','DOCKER_TLS','DOCKER_TLS_VERIFY','DOCKER_CERT_PATH']}
r=subprocess.run(cmd,input=data,env=env) if data is not None else subprocess.run(cmd,env=env)
sys.exit(r.returncode)
