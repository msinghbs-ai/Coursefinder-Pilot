    },
    {
      "name": "evidence_lineage_stats_source_null_count_check",
      "table": "pipeline.evidence_lineage_stats",
      "definition": "CHECK ((source_null_count >= 0))"
    },
    {
      "name": "evidence_entity_links_entity_type_check",
      "table": "pipeline.evidence_entity_links",
      "definition": "CHECK ((entity_type = ANY (ARRAY['provider'::text, 'course'::text, 'campus'::text, 'scholarship'::text])))"
    },
    {
      "name": "evidence_entity_links_evidence_id_fkey",
      "table": "pipeline.evidence_entity_links",
      "definition": "FOREIGN KEY (evidence_id) REFERENCES pipeline.evidence_artifacts(id) ON DELETE CASCADE"
    },
    {
      "name": "evidence_entity_links_link_count_check",
      "table": "pipeline.evidence_entity_links",
      "definition": "CHECK ((link_count >= 0))"
    },
    {
      "name": "evidence_entity_links_pkey",
      "table": "pipeline.evidence_entity_links",
      "definition": "PRIMARY KEY (evidence_id, entity_type, entity_id)"
    }
  ]
