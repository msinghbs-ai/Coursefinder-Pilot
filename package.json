{
  "name": "ciise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "test:uat": "playwright test -c tests/uat/playwright.config.js",
    "test:uat:headed": "playwright test -c tests/uat/playwright.config.js --headed",
    "test:uat:ui": "playwright test -c tests/uat/playwright.config.js --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@supabase/supabase-js": "latest",
    "lucide-react": "^0.468.0",
    "cloudinary": "^2.8.0",
    "http-proxy-middleware": "^3.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "wrangler": "^4.0.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
