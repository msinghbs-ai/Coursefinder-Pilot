{
  "name": "coursefinder-pilot",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "test:uat": "playwright test",
    "test:uat:smoke": "playwright test tests/uat/smoke.spec.mjs --project=chromium-desktop",
    "test:uat:deployed": "playwright test tests/uat/data-quality-deployed.spec.mjs --project=chromium-desktop",
    "test:uat:deployed:mobile": "playwright test tests/uat/data-quality-deployed.spec.mjs --project=chromium-mobile",
    "test:uat:report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "release:check": "node scripts/verify-release-notes.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "wrangler": "^4.120.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
