# CF-247 s810 (ASD ISM-1424, ISM-1717; Platform Admin 20 Nov 2026): browser security headers, sent by the Cloudflare Worker that serves this app's files.
# Read by Workers Static Assets from the built folder (Vite copies public/ into dist/). No operational value here: these are fixed safety rules.
# Script and connection sources are named; styles allow 'unsafe-inline' because React sets style attributes; images allow https: for provider logos.
# frame-src has no web origins: the only frames are sandboxed srcdoc previews (email preview, saved page viewer).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://fxcwkweaxjtknorudmwp.supabase.co wss://fxcwkweaxjtknorudmwp.supabase.co; frame-src 'self' about: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# s811 (ISM, RFC 9116): the security contact file is plain text, never the app page the single-page fallback would send
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# s1203 (Platform Admin via Atlas, 26 Nov 2026): the page is always re-checked, so a reload after a deploy gets the new index.html;
# the hashed files under /assets/ never change, so they are cached for a year. Fixed rules, set here and not in the Cloudflare dashboard.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
