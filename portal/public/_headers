# StudySearch Portal (s1140): browser security headers, same rules as the Admin app (s810). Fixed safety rules, no operational value.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://fxcwkweaxjtknorudmwp.supabase.co wss://fxcwkweaxjtknorudmwp.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
