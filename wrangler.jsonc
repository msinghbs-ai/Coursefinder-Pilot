{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coursefinder-pilot",
  "compatibility_date": "2026-08-11",
  "build": {
    "command": "node scripts/guard-provider-description-no-deploy.mjs"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
